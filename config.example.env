# Copy to a local, untracked file and fill in values. Never commit credentials.
IRC_SERVER=irc.example.com
IRC_PORT=6697
IRC_NICK=your-nickname
IRC_SASL_USERNAME=your-nickname
IRC_PASSWORD=your-password
IRC_CHANNEL=#your-channel

GC_API_BASE_URL=http://127.0.0.1:9443
GC_CITY_NAME=your-city
GC_PROVIDER=irc
GC_ACCOUNT_ID=your-account
GC_TARGET=your-target
# Set false only when the adapter is already registered.
GC_REGISTER_ADAPTER=true
